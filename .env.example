# Telegram
BOT_TOKEN=123456:ABC-DEF...

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://bot:bot@postgres:5432/bot

# Redis (FSM storage)
REDIS_URL=redis://redis:6379/0

# Ubilling API
UBILLING_URL=http://demo.ubilling.net.ua:9999/billing/userstats

# опционально, MD5 серийного номера (extended auth)
UBILLING_UBER_KEY=

# Настройки
SESSION_TTL_HOURS=-1             # время жизни сессии авторизации
DEFAULT_LOCALE=uk                # локаль по умолчанию (en, uk, ru)
LOG_LEVEL=DEBUG                  # уровень логирования

# Чат поддержки (опционально; пусто/не задано — фича выключена)
SUPPORT_CHAT_ID=                      # id группы поддержки (например, -1001234567890)
SUPPORT_TOPIC_ID=                     # id топика в группе (для форумных групп), опционально
SUPPORT_REACTION_UNANSWERED=👀        # реакция на сообщение без ответа
SUPPORT_REACTION_ANSWERED=👌          # реакция на отвеченное сообщение
SUPPORT_REACTION_UNDELIVERED=💔       # реакция на недоставленное сообщение
SUPPORT_AUTOCLOSE_HOURS=48            # автозакрытие диалога после N часов неактивности
