# Комментарии — на отдельных строках над переменной.
# Inline-комментарии (KEY=value # ...) dotenv трактует по-разному: у пустого
# значения весь «# ...» становится значением и ломает парсинг (например int-поля).

# Telegram
BOT_TOKEN=123456:ABC-DEF...

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://bot:bot@postgres:5432/bot

# Redis (FSM storage)
REDIS_URL=redis://redis:6379/0

# Ubilling API
UBILLING_URL=http://demo.ubilling.net.ua:9999/billing/userstats

# Опционально: MD5 серийного номера (extended auth)
UBILLING_UBER_KEY=

# Время жизни сессии авторизации в часах (-1 = бессрочно)
SESSION_TTL_HOURS=-1

# Локаль по умолчанию (en, uk, ru)
DEFAULT_LOCALE=uk

# Уровень логирования
LOG_LEVEL=DEBUG

# --- Чат поддержки (опционально; пусто/не задано — фича выключена) ---

# id группы поддержки (например, -1001234567890)
SUPPORT_CHAT_ID=

# id топика в группе (для форумных групп); пусто — общий поток группы
SUPPORT_TOPIC_ID=

# Реакция на сообщение без ответа (эмодзи или custom_emoji_id)
SUPPORT_REACTION_UNANSWERED=👀

# Реакция на отвеченное сообщение
SUPPORT_REACTION_ANSWERED=👌

# Реакция на недоставленное сообщение
SUPPORT_REACTION_UNDELIVERED=💔

# Автозакрытие диалога после N часов неактивности (0 или -1 — выключено)
SUPPORT_AUTOCLOSE_HOURS=48
